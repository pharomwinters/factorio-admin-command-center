# Auto detect text files and perform LF normalization
* text=auto

# Keep dev-only files out of the mod zip built by git archive (see build-mod.ps1).
# The mod portal rejects zips containing exe, bat, ps1, sh or py files.
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.vscode export-ignore
*.exe export-ignore
*.bat export-ignore
*.ps1 export-ignore
*.sh export-ignore
*.py export-ignore
